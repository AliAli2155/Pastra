<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts, until Flutter draws its first frame: the
         charcoal launch screen (also when the phone is in light mode). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind Flutter while it runs: charcoal, so nothing white ever flashes
         (turning the phone, coming back to the app). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/pastra_night</item>
    </style>
</resources>
