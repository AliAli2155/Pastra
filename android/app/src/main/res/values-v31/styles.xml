<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later show their own launch screen (the app icon in
         the middle): on the charcoal of the app. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/pastra_night</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/pastra_night</item>
    </style>
</resources>
